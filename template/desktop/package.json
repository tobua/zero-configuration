{
  "scripts": {
    "build": "rsbuild build",
    "check": "biome check --write .",
    "distribute": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-builder --dir",
    "start": "electron .",
    "test": "playwright test",
    "types": "tsc",
    "watch": "rsbuild build --watch",
    "web": "rsbuild dev --open"
  },
  "build": {
    "directories": {
      "output": "executable"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "zero-configuration": "^1.3.0"
  },
  "trustedDependencies": [
    "zero-configuration",
    "electron"
  ],
  "type": "module",
  "main": "main.js"
}
